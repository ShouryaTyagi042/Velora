VELORA_ADDR=:8080
VELORA_MEDIA_DIR=/Users/you/velora-media
# Browser origins allowed to call the API (Expo web). Native apps don't need this.
VELORA_CORS_ORIGINS=http://localhost:8081
VELORA_DATABASE_URL=postgres://velora:velora-dev@localhost:5432/velora?sslmode=disable
# Tests only: a database the Postgres tests may wipe. Unset, they skip.
VELORA_TEST_DSN=postgres://velora:velora-dev@localhost:5432/velora_test?sslmode=disable

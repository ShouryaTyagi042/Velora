.PHONY: run build test fmt vet
run:   ; VELORA_MEDIA_DIR=$${VELORA_MEDIA_DIR:-$$HOME/velora-media} VELORA_CORS_ORIGINS=$${VELORA_CORS_ORIGINS-http://localhost:8081} go run ./cmd/server
build: ; go build -o bin/velora-server ./cmd/server
test:  ; go test ./...
fmt:   ; gofmt -l -w .
vet:   ; go vet ./...
